{
  "name": "dumpster-lib",
  "version": "0.1.0",
  "description": "shared library for parsing wikimedia dumps",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "type": "module",
  "bin": {
    "dumpster": "./src/cli/bin.js"
  },
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "scripts": {
    "test": "node --test 'tests/*.test.js'",
    "watch": "node ./scratch.js",
    "lint": "eslint ."
  },
  "repository": "github:spencermountain/dumpster-lib",
  "engines": {
    "node": ">=20"
  },
  "prettier": {
    "trailingComma": "none",
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "commander": "^15.0.0",
    "html-entities": "2.6.0",
    "ink": "^7.1.1",
    "react": "^19.2.0",
    "wtf-plugin-classify": "2.1.0",
    "wtf-plugin-debug": "^0.0.1",
    "wtf-plugin-html": "1.0.0",
    "wtf-plugin-i18n": "1.0.2",
    "wtf-plugin-markdown": "1.0.1",
    "wtf-plugin-nsfw": "^1.0.0",
    "wtf-plugin-summary": "1.0.0",
    "wtf_wikipedia": "10.4.2"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./cli": {
      "types": "./types/cli.d.ts",
      "default": "./src/cli/index.js"
    },
    "./fixture": {
      "types": "./types/fixture.d.ts",
      "default": "./src/lib/fixture.js"
    }
  }
}
